# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/creator_pool

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your-refresh-secret-key
REFRESH_TOKEN_EXPIRATION=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry (Error Monitoring)
SENTRY_DSN=your-sentry-dsn

# Social Blade API (Optional)
SOCIAL_BLADE_API_KEY=your-social-blade-api-key

# Database (update these with your PostgreSQL credentials)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=quata123
DB_NAME=creator_pool
